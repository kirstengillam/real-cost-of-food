# Copy this file to .env and fill in real values, or export these directly
# in your shell / Lambda environment variables. Never commit a real .env file.

# Optional but recommended -- raises BLS rate limits from 25 to 500 queries/day.
# Register free at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Optional but recommended -- DEMO_KEY works but is heavily rate-limited.
# Register free at: https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=

# Required for RAG Q&A feature (Phase 2+) — generation (Claude).
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for RAG embeddings (Phase 2+) — Voyage AI (Anthropic does not offer embeddings).
# Get a free key at: https://www.voyageai.com
VOYAGE_API_KEY=
