---
import Layout from '../../layouts/Layout.astro';
import { getAllFoods, getFoodBySlug } from '../../lib/foods';

export function getStaticPaths() {
  return getAllFoods().map((food) => ({
    params: { slug: food.slug },
  }));
}

const { slug } = Astro.params;
const food = getFoodBySlug(slug as string);

if (!food) {
  throw new Error(`No food found for slug: ${slug}`);
}

const hasRealPrice = food.price.price_source === 'bls_avg_price' && food.price.avg_price_usd !== null;
const trendDirection = food.price.yoy_pct_change == null ? null : food.price.yoy_pct_change >= 0 ? 'up' : 'down';

// Short name strips parenthetical qualifiers for use in H1/title ("Eggs" not "Eggs (Grade A, Large)")
const shortName = food.display_name.replace(/\s*\(.*?\)\s*/g, '').trim();

const priceFormatted = hasRealPrice
  ? `$${food.price.avg_price_usd!.toFixed(2)}${food.price.avg_price_unit ? `/${food.price.avg_price_unit.replace('per ', '')}` : ''}`
  : null;

const asOfFormatted = food.price.as_of
  ? new Date(`${food.price.as_of}-01`).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : null;

const title = priceFormatted
  ? `${shortName} Prices: ${priceFormatted}${asOfFormatted ? ` (${asOfFormatted})` : ''} — Real Cost of Food`
  : `${shortName} Price & Nutrition — Real Cost of Food`;

const description = `What ${food.display_name} actually costs: current price, protein and calories per dollar, and inflation trend, sourced from BLS and USDA data.`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// All micronutrients live behind a collapsible "full nutrient profile" so
// the receipt stays readable -- only the macros (calories/protein/total fat/
// total carbs, the label-style fat and carb breakdowns, and the two headline
// per-dollar metrics stay always-visible. Saturated/trans fat moved into the
// always-visible fat breakdown -- see the "Nutrition per 100g" markup below.
// perDollarKey is null for "nutrients of excess" (sodium, cholesterol) --
// nobody wants more of those per dollar, so they're informational-only.
// showZero is true for the same group, since a real zero there is
// meaningful (e.g. "0mg cholesterol"), unlike a true micronutrient reading
// 0, which usually just means FDC didn't analyze it.
const micronutrients = [
  { key: 'iron_mg', perDollarKey: 'iron_mg_per_dollar', label: 'Iron', unit: 'mg' },
  { key: 'zinc_mg', perDollarKey: 'zinc_mg_per_dollar', label: 'Zinc', unit: 'mg' },
  { key: 'vitamin_b12_mcg', perDollarKey: 'vitamin_b12_mcg_per_dollar', label: 'Vitamin B12', unit: 'µg' },
  { key: 'folate_mcg', perDollarKey: 'folate_mcg_per_dollar', label: 'Folate', unit: 'µg' },
  { key: 'calcium_mg', perDollarKey: 'calcium_mg_per_dollar', label: 'Calcium', unit: 'mg' },
  { key: 'potassium_mg', perDollarKey: 'potassium_mg_per_dollar', label: 'Potassium', unit: 'mg' },
  { key: 'magnesium_mg', perDollarKey: 'magnesium_mg_per_dollar', label: 'Magnesium', unit: 'mg' },
  { key: 'vitamin_a_mcg', perDollarKey: 'vitamin_a_mcg_per_dollar', label: 'Vitamin A', unit: 'µg RAE' },
  { key: 'vitamin_c_mg', perDollarKey: 'vitamin_c_mg_per_dollar', label: 'Vitamin C', unit: 'mg' },
  { key: 'vitamin_d_mcg', perDollarKey: 'vitamin_d_mcg_per_dollar', label: 'Vitamin D', unit: 'µg' },
  { key: 'vitamin_e_mg', perDollarKey: 'vitamin_e_mg_per_dollar', label: 'Vitamin E', unit: 'mg' },
  { key: 'vitamin_k_mcg', perDollarKey: 'vitamin_k_mcg_per_dollar', label: 'Vitamin K', unit: 'µg' },
  { key: 'thiamin_mg', perDollarKey: 'thiamin_mg_per_dollar', label: 'Thiamin (B1)', unit: 'mg' },
  { key: 'riboflavin_mg', perDollarKey: 'riboflavin_mg_per_dollar', label: 'Riboflavin (B2)', unit: 'mg' },
  { key: 'niacin_mg', perDollarKey: 'niacin_mg_per_dollar', label: 'Niacin (B3)', unit: 'mg' },
  { key: 'vitamin_b6_mg', perDollarKey: 'vitamin_b6_mg_per_dollar', label: 'Vitamin B6', unit: 'mg' },
  { key: 'pantothenic_acid_mg', perDollarKey: 'pantothenic_acid_mg_per_dollar', label: 'Pantothenic Acid (B5)', unit: 'mg' },
  { key: 'phosphorus_mg', perDollarKey: 'phosphorus_mg_per_dollar', label: 'Phosphorus', unit: 'mg' },
  { key: 'selenium_mcg', perDollarKey: 'selenium_mcg_per_dollar', label: 'Selenium', unit: 'µg' },
  { key: 'copper_mg', perDollarKey: 'copper_mg_per_dollar', label: 'Copper', unit: 'mg' },
  { key: 'manganese_mg', perDollarKey: 'manganese_mg_per_dollar', label: 'Manganese', unit: 'mg' },
  { key: 'choline_mg', perDollarKey: 'choline_mg_per_dollar', label: 'Choline', unit: 'mg' },
  { key: 'sodium_mg', perDollarKey: null, label: 'Sodium', unit: 'mg', showZero: true },
  { key: 'cholesterol_mg', perDollarKey: null, label: 'Cholesterol', unit: 'mg', showZero: true },
] as const;

// Omega-3 components nest under polyunsaturated fat. FDC has no total-omega-3
// value and older records often omit ALA, so only components actually reported
// (> 0) are shown -- never a summed total.
const omega3Candidates = [
  { key: 'omega3_ala_g', label: 'ALA (omega-3)' },
  { key: 'omega3_epa_g', label: 'EPA (omega-3)' },
  { key: 'omega3_dha_g', label: 'DHA (omega-3)' },
] as const;
const omega3Rows = food.nutrition_per_100g
  ? omega3Candidates.filter((o) => (food.nutrition_per_100g![o.key] ?? 0) > 0)
  : [];

const visibleMicronutrients = food.nutrition_per_100g
  ? micronutrients.filter((m) => {
      const val = food.nutrition_per_100g![m.key];
      return 'showZero' in m ? val != null : val != null && val > 0;
    })
  : [];

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonicalUrl,
  author: { '@type': 'Organization', name: 'Real Cost of Food' },
  publisher: { '@type': 'Organization', name: 'Real Cost of Food', url: new URL('/', Astro.site).href },
  ...(food.price.as_of ? { dateModified: `${food.price.as_of}-01` } : {}),
};
---
<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="page">
    <header class="masthead">
      <a href="/" class="masthead-link">Real Cost of Food</a>
      <p class="masthead-sub">an itemized look at what your groceries actually buy you</p>
    </header>

    <article class="receipt">
      <div class="receipt-header">
        <span class="eyebrow">{food.category}</span>
        <h1>{priceFormatted ? `${shortName} cost ${priceFormatted}` : shortName}</h1>
        <p class="serving-note">priced and measured per {food.serving_unit}</p>
      </div>

      <div class="line-item line-item--price">
        <span class="line-label">Current price{food.price.avg_price_unit ? ` (${food.price.avg_price_unit})` : ''}</span>
        <span class="line-dots" aria-hidden="true"></span>
        <span class="line-value">
          {hasRealPrice ? `$${food.price.avg_price_usd!.toFixed(2)}` : '— not yet priced —'}
        </span>
      </div>

      {!hasRealPrice && (
        <p class="disclosure">
          We don't have a verified government price series for this item yet.
          We'd rather show nothing than guess. <a href="/methodology">Why we do this →</a>
        </p>
      )}

      {hasRealPrice && food.price.as_of && (
        <p class="as-of">as of {food.price.as_of} · U.S. city average · source: BLS</p>
      )}

      {trendDirection && (
        <div class={`stamp stamp--${trendDirection}`}>
          {trendDirection === 'up' ? '▲' : '▼'} {Math.abs(food.price.yoy_pct_change!)}% vs last year
        </div>
      )}

      <div class="divider" aria-hidden="true"></div>

      <h2 class="section-heading">What that price actually buys you</h2>

      {food.nutrition_per_100g && (
        <>
          {food.value_metrics.suppressed_reason ? (
            <p class="disclosure">{food.value_metrics.suppressed_reason}</p>
          ) : (
            <>
          <div class="line-item">
            <span class="line-label">Protein per dollar</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">
              {food.value_metrics.protein_g_per_dollar != null
                ? `${food.value_metrics.protein_g_per_dollar} g`
                : '—'}
            </span>
          </div>
          <div class="line-item">
            <span class="line-label">Calories per dollar</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">
              {food.value_metrics.calories_per_dollar != null
                ? Math.round(food.value_metrics.calories_per_dollar)
                : '—'}
            </span>
          </div>
            </>
          )}
          <div class="divider" aria-hidden="true"></div>
          <h2 class="section-heading">Nutrition per 100g</h2>

          <div class="line-item line-item--muted">
            <span class="line-label">Calories</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.energy_kcal ?? '—'} kcal</span>
          </div>
          <div class="line-item line-item--muted">
            <span class="line-label">Protein</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.protein_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted">
            <span class="line-label">Total Fat</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.fat_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted line-item--sub">
            <span class="line-label">Saturated Fat</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.saturated_fat_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted line-item--sub">
            <span class="line-label">Trans Fat</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.trans_fat_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted line-item--sub">
            <span class="line-label">Polyunsaturated Fat</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.polyunsaturated_fat_g ?? '—'} g</span>
          </div>
          {omega3Rows.map((o) => (
            <div class="line-item line-item--muted line-item--sub2">
              <span class="line-label">{o.label}</span>
              <span class="line-dots" aria-hidden="true"></span>
              <span class="line-value">{food.nutrition_per_100g![o.key]} g</span>
            </div>
          ))}
          <div class="line-item line-item--muted line-item--sub">
            <span class="line-label">Monounsaturated Fat</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.monounsaturated_fat_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted">
            <span class="line-label">Total Carbohydrate</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.carbs_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted line-item--sub">
            <span class="line-label">Dietary Fiber</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.fiber_g ?? '—'} g</span>
          </div>
          <div class="line-item line-item--muted line-item--sub">
            <span class="line-label">Total Sugars</span>
            <span class="line-dots" aria-hidden="true"></span>
            <span class="line-value">{food.nutrition_per_100g.sugars_g ?? '—'} g</span>
          </div>
          {visibleMicronutrients.length > 0 && (
            <details class="micro-details">
              <summary>Full nutrient profile ({visibleMicronutrients.length} more)</summary>
              {visibleMicronutrients.map((m) => {
                const perDollar = m.perDollarKey ? food.value_metrics[m.perDollarKey] : null;
                return (
                  <div class="line-item line-item--muted">
                    <span class="line-label">{m.label}</span>
                    <span class="line-dots" aria-hidden="true"></span>
                    <span class="line-value">
                      {food.nutrition_per_100g![m.key]} {m.unit}
                      {perDollar != null && perDollar > 0 ? ` · ${perDollar} ${m.unit}/$` : ''}
                    </span>
                  </div>
                );
              })}
            </details>
          )}

          <p class="as-of">nutrition source: USDA FoodData Central{food.nutrition_per_100g.source_fdc_id ? ` (FDC #${food.nutrition_per_100g.source_fdc_id})` : ''}</p>
        </>
      )}

      {food.sustainability && (
        <>
          <div class="divider" aria-hidden="true"></div>
          <h2 class="section-heading">Beyond the price tag</h2>
          <div class="tier-row">
            <span class="tier-label">Water use</span>
            <span class={`tier-pill tier-pill--${food.sustainability.water_use_tier}`}>{food.sustainability.water_use_tier}</span>
          </div>
          <div class="tier-row">
            <span class="tier-label">Storage life</span>
            <span class={`tier-pill tier-pill--${food.sustainability.storage_life_tier}`}>{food.sustainability.storage_life_tier}</span>
          </div>
          {food.sustainability.typical_local_production && (
            <p class="local-note">{food.sustainability.typical_local_production}</p>
          )}
          <p class="citation">source: {food.sustainability.source_citation}</p>
        </>
      )}
    </article>

    <footer class="site-footer">
      <p>Prices: U.S. Bureau of Labor Statistics. Nutrition: USDA FoodData Central. Updated monthly.</p>
      <p><a href="/methodology">Methodology</a> · <a href="/">All foods</a></p>
    </footer>
  </main>
</Layout>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .masthead {
    text-align: center;
    margin-bottom: 2rem;
  }
  .masthead-link {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.4rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .masthead-sub {
    font-size: 0.8rem;
    color: var(--thermal-gray);
    margin: 0.25rem 0 0;
  }

  .receipt {
    background: var(--paper);
    border: 1px solid var(--paper-edge);
    box-shadow: 0 2px 0 var(--paper-edge), 0 1px 18px rgba(0,0,0,0.06);
    padding: 2rem 1.75rem;
  }

  .receipt-header { margin-bottom: 1.5rem; }

  .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--produce-green);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  h1 {
    font-size: 1.9rem;
    font-weight: 900;
    line-height: 1.05;
  }

  .serving-note {
    font-size: 0.8rem;
    color: var(--thermal-gray);
    margin: 0.4rem 0 0;
  }

  .line-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.55rem 0;
    font-size: 1rem;
  }
  .line-item--price {
    font-size: 1.15rem;
    font-weight: 600;
    padding-top: 1rem;
  }
  .line-item--muted {
    color: var(--thermal-gray);
    font-size: 0.88rem;
  }
  .line-item--sub {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
    font-size: 0.8rem;
  }
  .line-item--sub .line-label {
    padding-left: 1rem;
  }
  .line-item--sub2 {
    padding-top: 0.2rem;
    padding-bottom: 0.2rem;
    font-size: 0.75rem;
  }
  .line-item--sub2 .line-label {
    padding-left: 2rem;
  }
  .line-label { flex-shrink: 0; }
  .line-dots {
    flex: 1;
    border-bottom: 1px dotted var(--line-dotted);
    height: 0.6em;
    margin: 0 0.25rem;
  }
  .line-value { flex-shrink: 0; font-weight: 600; }
  .line-item--muted .line-value { font-weight: 500; }

  .disclosure {
    font-size: 0.82rem;
    color: var(--thermal-gray);
    background: var(--paper-edge);
    padding: 0.6rem 0.75rem;
    margin-top: 0.5rem;
  }

  .micro-details {
    margin-top: 0.25rem;
  }
  .micro-details summary {
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--ink-faded);
    padding: 0.4rem 0;
    list-style: revert;
  }
  .micro-details summary:hover {
    color: var(--ink);
  }
  .micro-details .line-item {
    padding-left: 0.25rem;
  }

  .as-of, .citation {
    font-size: 0.72rem;
    color: var(--thermal-gray);
    margin: 0.3rem 0 0;
  }
  .citation { font-style: italic; }

  .stamp {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    padding: 0.3rem 0.7rem;
    border: 2px solid currentColor;
    border-radius: 3px;
    transform: rotate(-2deg);
  }
  .stamp--up { color: var(--stamp-red); }
  .stamp--down { color: var(--produce-green); }

  .divider {
    border-top: 1px dashed var(--line-dotted);
    margin: 1.5rem 0 1.25rem;
  }

  .section-heading {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .tier-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0;
  }
  .tier-label { width: 7rem; font-size: 0.85rem; color: var(--ink-faded); }
  .tier-pill {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .tier-pill--low, .tier-pill--long { background: #E4EADC; color: var(--produce-green); }
  .tier-pill--medium, .tier-pill--short { background: #F0E6D6; color: #8A5A2B; }
  .tier-pill--high { background: #F4DCD8; color: var(--stamp-red); }

  .local-note {
    font-size: 0.85rem;
    color: var(--ink-faded);
    margin: 0.6rem 0 0.2rem;
  }

  .site-footer {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.72rem;
    color: var(--thermal-gray);
  }
  .site-footer p { margin: 0.2rem 0; }
</style>
