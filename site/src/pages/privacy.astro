         <h2>Contact</h2>
         <p>Questions about this policy? Email <a href="mailto:privacy@[yourdomain].com">privacy@[yourdomain].com</a>.</p>
         Set up the alias via Cloudflare Email Routing before publishing. -->

    <p><a href="/">← Back to all foods</a></p>
  </main>
</Layout>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
    line-height: 1.6;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.9rem;
    margin-bottom: 0.5rem;
  }
  .updated {
    font-size: 0.8rem;
    color: var(--thermal-gray);
    margin-bottom: 1.5rem;
  }
  h2 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.4rem;
  }
  p { font-size: 0.92rem; color: var(--ink-faded); margin: 0.4rem 0; }
</style>
